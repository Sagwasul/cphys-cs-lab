# ⚠ 本文件只放"变量名 + 占位符"，**绝不能填入真实密钥**。
# 真实值通过平台的环境变量界面 / CLI 注入：
#   Vercel:     vercel env add AI_API_KEY production
#   Cloudflare: wrangler secret put AI_API_KEY
#
# 如果你在本地想用 vercel dev 调试，复制成 .env（已在 .gitignore 里）再填真值。

# ── 必填 ─────────────────────────────────────────────────────
# 你的模型服务子密钥。只授予必要权限，并在提供方后台设置消费上限。
AI_API_KEY=

# 允许调用本代理的前端 Origin（逗号分隔，精确匹配，不要带结尾斜杠）。
# GitHub Pages 默认域名形如 https://<用户名>.github.io
# 若部署在子路径（https://<用户名>.github.io/<仓库名>），Origin 仍然是 https://<用户名>.github.io
# 本地开发时再加上 http://127.0.0.1:5173
ALLOWED_ORIGINS=https://your-name.github.io,http://127.0.0.1:5173

# ── 模型 ─────────────────────────────────────────────────────
# openai（OpenAI 兼容协议，DeepSeek / 通义 / Moonshot / OpenAI 都走这个）或 anthropic
AI_PROVIDER=openai
# DeepSeek: https://api.deepseek.com/v1  |  通义: https://dashscope.aliyuncs.com/compatible-mode/v1
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_MAX_OUTPUT_TOKENS=1200
AI_TEMPERATURE=0.3
AI_UPSTREAM_TIMEOUT_MS=45000

# ── 速率限制 ─────────────────────────────────────────────────
# 每 IP 每分钟 / 每天的上限。这是防止密钥被刷爆的主要手段。
RATE_LIMIT_PER_MIN=20
RATE_LIMIT_PER_DAY=300

# ── 可选：跨实例一致的限流（强烈建议生产环境配置）────────────
# Upstash Redis 的 REST 接口。不配置时退化为进程内存限流：
# 在 Vercel 上多实例/冷启动下会被放宽，因此生产环境建议配置。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── 调试 ─────────────────────────────────────────────────────
# 设为 1 时打印更详细的诊断日志（仍然不打印消息内容与密钥）。
AI_DEBUG=0
